rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Only you. Sign up on the site with this email first so nobody else can take it.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'emmanueloluwadamijohn18@gmail.com';
    }

    // Each student's own profile: name, combo, score history, premium, activation pin.
    match /practiceUsers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Questions you paste in admin.html. Students read them, only you write them.
    match /practiceQuestions/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Leaderboard results. Students can only add their own; only you can delete.
    match /practiceResults/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Activation pin counter. It can only ever go up by exactly 1, so it can't be reset.
    match /meta/practicePinPool {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.nextIndex == 1;
      allow update: if signedIn() && request.resource.data.nextIndex == resource.data.nextIndex + 1;
    }
  }
}
